{
  "name": "@a2ui/core",
  "version": "1.0.0",
  "description": "A2UI core SDK - UI component library and rendering engine",
  "type": "module",
  "main": "dist/index.js",
  "module": "src/index.ts",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./dist/index.d.ts"
    },
    "./mock/*": {
      "import": "./mock/*"
    }
  },
  "scripts": {
    "test": "mocha",
    "test:store": "mocha --config .mocharc.store.json",
    "test:parser": "mocha --config .mocharc.parser.json"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "chai": "^6.2.2",
    "mocha": "^11.7.6",
    "tsx": "^4.23.1",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "zustand": "^5.0.14"
  }
}
